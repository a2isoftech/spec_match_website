{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY"
  },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=604800" } }
  ],
  "mimeTypes": { ".webp": "image/webp" }
}
